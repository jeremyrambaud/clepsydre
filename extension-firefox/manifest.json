{
  "manifest_version": 2,
  "name": "Clepsydre companion — Redmine Timer",
  "version": "1.0.0.13",
  "description": "Start and stop Clepsydre app timers directly from Redmine issue pages.",
  "permissions": [
    "nativeMessaging",
    "*://*/*/issues/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*/issues/*",
        "*://*/issues/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "clepsydre@clepsydre.app",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "version_name": "1.0.0-beta.13"
}
