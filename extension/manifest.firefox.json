{
  "manifest_version": 2,
  "name": "Clepsydre companion - Redmine Timer",
  "version": "1.0.0",
  "description": "Start and stop Clepsydre app timers directly from Redmine issue pages.",
  "permissions": ["nativeMessaging", "*://*/*/issues/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["*://*/*/issues/*", "*://*/issues/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "applications": {
    "gecko": {
      "id": "clepsydre@clepsydre.app",
      "strict_min_version": "109.0"
    }
  }
}
