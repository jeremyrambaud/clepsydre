{
  "manifest_version": 3,
  "name": "Clepsydre companion — Redmine Timer",
  "version": "1.0.0.14",
  "description": "Start and stop Clepsydre timers directly from Redmine issue pages.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:23847/*",
    "http://localhost:23847/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*/issues/*",
        "*://*/issues/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "clepsydre@clepsydre.app",
      "strict_min_version": "109.0"
    }
  },
  "version_name": "1.0.0-beta.14"
}
